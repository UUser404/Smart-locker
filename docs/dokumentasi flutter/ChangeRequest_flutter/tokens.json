{
  "meta": {
    "name": "Smart Locker Design System",
    "version": "1.0.0",
    "note": "Single source of truth. tokens.css, tokens.figma.json, app_tokens.dart and the admin screens are generated from this file by build_design_system.py."
  },
  "color": {
    "brand": {
      "primary": "#1D4ED8",
      "primaryContainer": "#DBEAFE",
      "onPrimary": "#FFFFFF"
    },
    "neutral": {
      "bg": "#F5F7FA",
      "surface": "#FFFFFF",
      "surfaceMuted": "#F8FAFC",
      "fillMuted": "#F1F5F9",
      "border": "#E2E8F0",
      "borderStrong": "#CBD5E1",
      "ink": "#0F172A",
      "textBody": "#475569",
      "textMuted": "#64748B",
      "textDisabled": "#94A3B8",
      "inverse": "#0F172A",
      "inverseRaised": "#1E293B",
      "onInverse": "#FFFFFF",
      "onInverseMuted": "#CBD5E1"
    },
    "success": {
      "main": "#16A34A",
      "container": "#DCFCE7",
      "tint": "#F0FDF4",
      "border": "#BBF7D0",
      "text": "#166534",
      "strong": "#14532D"
    },
    "info": {
      "main": "#2563EB",
      "container": "#DBEAFE",
      "tint": "#EFF6FF",
      "border": "#BFDBFE",
      "text": "#1D4ED8",
      "strong": "#1E3A8A"
    },
    "warning": {
      "main": "#EA580C",
      "container": "#FFEDD5",
      "tint": "#FFF7ED",
      "border": "#FDBA74",
      "text": "#C2410C",
      "strong": "#9A3412"
    },
    "danger": {
      "main": "#DC2626",
      "container": "#FEE2E2",
      "tint": "#FEF2F2",
      "border": "#FECACA",
      "text": "#B91C1C",
      "strong": "#7F1D1D"
    }
  },
  "semantic": {
    "state": {
      "kosong": "success",
      "disewa": "info",
      "perhatian": "warning",
      "offline": "danger",
      "darurat": "danger"
    }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },
  "radius": { "tag": 6, "field": 12, "button": 14, "card": 16, "hero": 18, "sheet": 28, "pill": 999 },
  "size": {
    "touchMin": 44,
    "buttonLg": 52,
    "buttonMd": 44,
    "buttonSm": 36,
    "chip": 32,
    "appBar": 56,
    "bottomNav": 80,
    "topbar": 64,
    "sidebar": 240,
    "contentMax": 1136
  },
  "breakpoint": { "compact": 0, "medium": 600, "expanded": 1024 },
  "motion": { "fast": 120, "base": 200, "slow": 320, "holdToConfirm": 2000 },
  "opacity": { "scrim": 0.55, "disabled": 0.5 },
  "shadow": {
    "sheet": "0 -8px 24px rgba(15, 23, 42, 0.12)",
    "popover": "0 8px 24px rgba(15, 23, 42, 0.12)"
  },
  "font": { "family": "Inter, Roboto, Arial, sans-serif" },
  "type": {
    "display":    { "size": 40, "weight": 800, "line": 44 },
    "headline":   { "size": 22, "weight": 800, "line": 28 },
    "title":      { "size": 18, "weight": 800, "line": 24 },
    "subtitle":   { "size": 15, "weight": 800, "line": 20 },
    "bodyStrong": { "size": 14, "weight": 700, "line": 20 },
    "body":       { "size": 14, "weight": 400, "line": 20 },
    "bodySm":     { "size": 13, "weight": 400, "line": 18 },
    "caption":    { "size": 12, "weight": 400, "line": 16 },
    "overline":   { "size": 11, "weight": 700, "line": 16, "letterSpacing": 0.8 },
    "micro":      { "size": 10, "weight": 800, "line": 12 }
