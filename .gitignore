# ============================================================
# Root .gitignore - Smart Locker IoT
# ============================================================

# ------------------------------------------------------------
# Node.js / Express (backend-express)
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.eslintcache
.env
.env.local
.env.*.local

# ------------------------------------------------------------
# Firmware (ESP32 / PlatformIO / Arduino)
# ------------------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
*.bin
*.elf
*.hex
*.map

# ------------------------------------------------------------
# Miscellaneous
# ------------------------------------------------------------
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# ------------------------------------------------------------
# IntelliJ / IDE related
# ------------------------------------------------------------
**/.idea/
.idea/
*.iml
*.ipr
*.iws

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# ------------------------------------------------------------
# Flutter / Dart related
# ------------------------------------------------------------
**/.dart_tool/
**/build/
.dart_tool/
build/

**/doc/api/
**/ios/Flutter/.last_build_id
.flutter-plugins-dependencies
.pub-cache/
.pub/
/coverage/
**/coverage/

# ------------------------------------------------------------
# Firebase configuration (sensitive)
# ------------------------------------------------------------
# File firebase_options.dart berisi konfigurasi Firebase (API key, project ID,
# app ID, dll). Jangan di-commit ke repository publik.
**/firebase_options.dart
firebase_options.dart

# File kredensial Firebase lainnya
google-services.json
GoogleService-Info.plist
serviceAccountKey.json

# ------------------------------------------------------------
# Symbolication related
# ------------------------------------------------------------
app.*.symbols

# ------------------------------------------------------------
# Obfuscation related
# ------------------------------------------------------------
app.*.map.json

# ------------------------------------------------------------
# Android build artifacts
# ------------------------------------------------------------
/android/app/debug
/android/app/profile
/android/app/release
**/android/app/debug
**/android/app/profile
**/android/app/release

# ------------------------------------------------------------
# OS & Editor junk
# ------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
*~
*.bak
*.tmp

# ------------------------------------------------------------
# Office temp files (mis. dari folder docs/elisitasi)
# ------------------------------------------------------------
~$*.docx
~$*.xlsx
~$*.pptx
~$*.doc
~$*.xls
~$*.ppt

# ------------------------------------------------------------
# Environment & secrets
# ------------------------------------------------------------
*.pem
*.key
*.crt
*.p12